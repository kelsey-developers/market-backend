PORT=4000
APP_PORT=4000
NODE_ENV=development
DATABASE_URL="mysql://market_user:market_pass@localhost:3308/market"
CORS_ORIGIN="http://localhost:3000"

# Cloudflare tunnel mode:
# - quick: rotating *.trycloudflare.com URL
# - fixed: named tunnel with stable hostname
CLOUDFLARED_MODE=quick

# Required for fixed mode (example: market-api)
CLOUDFLARED_TUNNEL_NAME=

# Optional: override local backend URL for quick mode
CLOUDFLARED_TARGET_URL=http://127.0.0.1:4000

# Optional: explicit cloudflared config file path for fixed mode
# CLOUDFLARED_CONFIG=C:\Users\<you>\.cloudflared\config.yml
